# Copie para .env. Nunca versione credenciais reais.
# Gere um token longo e aleatório antes de iniciar.
BRUCE_API_KEY=SUBSTITUA_POR_TOKEN_ALEATORIO_LONGO
# Ollama local com API OpenAI-compatible. Em nuvem, use um endpoint acessível pelo servidor.
BRUCE_MODEL_BASE_URL=http://127.0.0.1:11434/v1
BRUCE_MODEL_API_KEY=
BRUCE_MODEL_NAME=llama3.2
BRUCE_SYSTEM_PROMPT=You are BRUCE, the user's personal assistant. Be capable, direct, thoughtful, proactive, and transparent. Ask approval before sensitive, external, financial, or irreversible actions.
BRUCE_MAX_CONTEXT_MESSAGES=80
BRUCE_MAX_OUTPUT_TOKENS=4096
BRUCE_DATABASE_PATH=./data/bruce.sqlite3
# Ajuste para a origem web real quando a interface estiver hospedada.
BRUCE_ALLOWED_ORIGINS=https://bruce-preview-six.vercel.app,https://bruce-preview-petersonjunior253-8756s-projects.vercel.app,http://localhost:5173,http://127.0.0.1:5173
