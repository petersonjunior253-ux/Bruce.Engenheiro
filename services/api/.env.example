# Configuração do servidor BRUCE. Nunca comite valores reais.
# Chave privada usada pelo aplicativo para acessar a API BRUCE.
BRUCE_API_KEY=troque-por-um-segredo-longo-e-aleatorio

# Primeiro motor recomendado: Ollama no mesmo servidor.
# Para Ollama, use a URL compatível com a API local e deixe MODEL_API_KEY vazio.
BRUCE_MODEL_BASE_URL=http://127.0.0.1:11434/v1
BRUCE_MODEL_API_KEY=
BRUCE_MODEL_NAME=llama3.2

# Também pode apontar para outro servidor/modelo compatível com a API de chat.
BRUCE_SYSTEM_PROMPT=Você é BRUCE, um assistente pessoal privado, proativo e transparente. Responda em português brasileiro. Peça aprovação para ações sensíveis.
BRUCE_MAX_CONTEXT_MESSAGES=60
BRUCE_MAX_OUTPUT_TOKENS=4096
BRUCE_REQUEST_TIMEOUT_SECONDS=180
BRUCE_DATABASE_PATH=./data/bruce.sqlite3
# Em produção, configure os domínios reais do app.
BRUCE_ALLOWED_ORIGINS=https://seu-dominio-do-app.com
