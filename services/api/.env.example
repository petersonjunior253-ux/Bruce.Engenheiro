# BRUCE API — configure secrets somente no ambiente do servidor
BRUCE_API_KEY=GERE_UM_TOKEN_ALEATORIO_LONGO_E_PRIVADO
# Ollama local: http://127.0.0.1:11434/v1 (somente se API e Ollama estiverem na mesma máquina)
# Claude API oficial (a chave fica apenas no servidor/Vercel)
BRUCE_ANTHROPIC_API_KEY=
BRUCE_MODEL_NAME=claude-sonnet-5-5
# Alternativa: endpoint OpenAI-compatible (ex.: Ollama em desenvolvimento)
BRUCE_MODEL_BASE_URL=http://127.0.0.1:11434/v1
BRUCE_MODEL_API_KEY=
BRUCE_SYSTEM_PROMPT=Você é BRUCE, assistente pessoal privado. Responda em português brasileiro, seja direto, natural e proativo. Nunca afirme que executou algo sem confirmação do dispositivo.
BRUCE_MAX_CONTEXT_MESSAGES=80
BRUCE_MAX_OUTPUT_TOKENS=4096
BRUCE_DATABASE_PATH=./data/bruce.sqlite3
BRUCE_DEVICE_ONLINE_SECONDS=90
BRUCE_ALLOWED_ORIGINS=https://bruce-preview-six.vercel.app,https://bruce-preview-petersonjunior253-8756s-projects.vercel.app,http://localhost:5173,http://127.0.0.1:5173
