# Copy to .env. Never commit real credentials.
BRUCE_API_KEY=change-this-to-a-long-random-secret
BRUCE_MODEL_BASE_URL=https://api.openai.com/v1
BRUCE_MODEL_API_KEY=
BRUCE_MODEL_NAME=
BRUCE_SYSTEM_PROMPT=You are BRUCE, the user's personal assistant. Be capable, direct, thoughtful, and transparent. Ask approval before sensitive, external, financial, or irreversible actions.
BRUCE_MAX_CONTEXT_MESSAGES=80
BRUCE_MAX_OUTPUT_TOKENS=4096
BRUCE_DATABASE_PATH=./data/bruce.sqlite3
